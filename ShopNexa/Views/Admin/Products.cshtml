@model IEnumerable<Product>
@{
    ViewData["Title"] = "Manage products";
    Layout = "_AdminLayout";
    var sellerCompanyByUserId = ViewBag.SellerCompanyByUserId as Dictionary<string, string>;
    var adminUserIds = ViewBag.AdminUserIds as HashSet<string>;
}

<div class="py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Products</h2>
        <div class="btn-group">
            <a class="btn btn-outline-secondary" asp-action="Categories">Categories</a>
            <a class="btn btn-primary" asp-action="CreateProduct">Add product</a>
        </div>
    </div>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Seller</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isAdminProduct = item.SellerId == null || (adminUserIds != null && item.SellerId != null && adminUserIds.Contains(item.SellerId));
                        var sellerCompanyName = item.SellerId != null && sellerCompanyByUserId != null && sellerCompanyByUserId.ContainsKey(item.SellerId) ? sellerCompanyByUserId[item.SellerId] : null;
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Category?.Name</td>
                            <td>₹@item.Price.ToString("N2")</td>
                            <td>@item.Stock</td>
                            <td>
                                @if (isAdminProduct)
                                {
                                    <span class="badge bg-success">Admin Product</span>
                                }
                                else if (!string.IsNullOrEmpty(sellerCompanyName))
                                {
                                    <span class="badge bg-primary">Seller: @sellerCompanyName</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Seller: —</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="EditProduct"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary">
                                        Edit
                                    </a>
                                    <form asp-action="DeleteProduct"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline">
                                        <button type="submit"
                                                class="btn btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete this product?');">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

