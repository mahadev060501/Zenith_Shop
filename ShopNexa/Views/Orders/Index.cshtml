@model IEnumerable<Order>
@{
    ViewData["Title"] = "My Orders";
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 20px;
        border: 1px solid rgba(148, 163, 184, 0.25);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
        margin-bottom: 24px;
        padding: 26px 28px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .order-card {
        border-radius: 20px;
    }

    .glass-card.order-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.18);
    }

    .order-status-badge,
    .status-badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: .02em;
    }

    .bg-gradient-purple {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    }

    .payment-status-badge {
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
    }
    .refund-section {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        border: 2px solid #ffc107;
        border-radius: 15px;
        padding: 20px;
        margin: 15px 0;
    }
    .action-btn {
        padding: 10px 22px;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 999px;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 8px 18px rgba(40, 116, 240, 0.25);
        background: linear-gradient(135deg, #2874f0 0%, #1d4ed8 100%);
        color: #ffffff;
    }

    .action-btn:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.32);
        color: #ffffff;
    }

    .action-btn.btn-warning {
        background: transparent;
        color: #92400e;
        border: 2px solid #fbbf24;
        box-shadow: none;
    }

    .action-btn.btn-warning:hover {
        background: linear-gradient(135deg, #f59e0b 0%, #fb923c 100%);
        border-color: transparent;
        color: #111827;
        box-shadow: 0 10px 24px rgba(245, 158, 11, 0.45);
    }

    .action-btn.btn-danger {
        background: transparent;
        color: #b91c1c;
        border: 2px solid #fca5a5;
        box-shadow: none;
    }

    .action-btn.btn-danger:hover {
        background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
        border-color: transparent;
        color: #ffffff;
        box-shadow: 0 10px 26px rgba(239, 68, 68, 0.55);
    }
    .order-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: #333;
        margin-bottom: 15px;
    }
    .order-detail {
        font-size: 1.1rem;
        font-weight: 600;
        color: #555;
        margin-bottom: 10px;
    }
    .amount-display {
        font-size: 2rem;
        font-weight: 800;
        color: #667eea;
    }

    .order-meta {
        font-size: 0.9rem;
        color: #6b7280;
    }

    .order-meta span + span::before {
        content: "•";
        margin: 0 6px;
        color: #9ca3af;
    }

    .order-top-row {
        gap: 18px;
    }

    @@media (max-width: 768px) {
        .order-top-row {
            flex-direction: column;
            align-items: flex-start !important;
        }
    }
</style>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0" style="font-size: 2.5rem; font-weight: 800;">
        <i class="bi bi-receipt"></i> My Orders
    </h1>
        @if (ViewBag.TotalItemsOrdered != null)
        {
            <div class="text-end">
                <div class="alert alert-info mb-0" style="font-size: 1.1rem; font-weight: 700;">
                    <i class="bi bi-box-seam"></i> Total Items Ordered: <strong>@ViewBag.TotalItemsOrdered</strong>
                    <br>
                    <small style="font-size: 0.9rem; font-weight: 600;">Across @ViewBag.TotalOrders order(s)</small>
                </div>
            </div>
        }
    </div>
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info glass-card" style="font-size: 1.2rem; font-weight: 600;">
            <i class="bi bi-info-circle"></i> No orders yet. Start shopping!
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var order in Model)
            {
                <div class="list-group-item glass-card order-card mb-4">
                    <div class="d-flex justify-content-between align-items-start order-top-row">
                        <div class="flex-grow-1">
                            <div class="order-title d-flex flex-wrap align-items-center gap-2">
                                <span>Order #@order.Id</span>
                                @{
                                    var statusClass = order.Status == "Pending" ? "bg-warning text-dark"
                                        : order.Status == "Confirmed" ? "bg-primary"
                                        : order.Status == "Shipped" ? "bg-gradient-purple text-white"
                                        : order.Status == "Delivered" ? "bg-success"
                                        : order.Status == "Returned" ? "bg-dark text-white"
                                        : order.Status == "Cancelled" ? "bg-danger text-white"
                                        : "bg-secondary text-dark";
                                }
                                <span class="order-status-badge status-badge @statusClass">
                                    @order.Status
                                </span>
                            </div>
                            <div class="order-detail order-meta">
                                <span><i class="bi bi-calendar"></i> @(order.CreatedAt != default(DateTime) ? order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") : "Date not available")</span>
                                <span><i class="bi bi-hash"></i> Order ID: @order.Id</span>
                            </div>
                            <div class="mb-3">
                                <span class="payment-status-badge 
                                    @(order.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark") text-white">
                                    <i class="bi bi-credit-card"></i> @(order.PaymentStatus ?? "Pending")
                                </span>
                                @if (!string.IsNullOrEmpty(order.PaymentMethod))
                                {
                                    var pm = order.PaymentMethod ?? "COD";
                                    var pmLabel = pm == "Razorpay" ? "Razorpay Online" :
                                                  (pm == "COD" || pm == "CashOnDelivery") ? "Cash on Delivery" : pm;
                                    <span class="badge bg-info ms-2" style="font-size: 0.9rem; font-weight: 600;">@pmLabel</span>
                                }
                                else
                                {
                                    <span class="badge bg-info ms-2" style="font-size: 0.9rem; font-weight: 600;">Cash on Delivery</span>
                                }
                                <!-- Legacy TransactionId badge removed to simplify payment tracking -->
                            </div>

                            <!-- Flipkart-style Refund Section -->
                            @if (!string.IsNullOrEmpty(order.RefundStatus) && order.RefundStatus != "Not Applicable")
                            {
                                <div class="refund-section">
                                    <h5 style="font-weight: 800; color: #856404; margin-bottom: 10px;">
                                        <i class="bi bi-arrow-counterclockwise"></i> Refund Status
                                    </h5>
                                    <div style="font-size: 1.1rem; font-weight: 600;">
                                        <strong>Status:</strong> 
                                        <span class="@(order.RefundStatus == "Completed" ? "text-success" : 
                                                      order.RefundStatus == "Processing" ? "text-warning" : "text-info")">
                                            @order.RefundStatus
                                        </span>
                                    </div>
                                    @if (order.RefundAmount.HasValue)
                                    {
                                        <div style="font-size: 1.1rem; font-weight: 600; margin-top: 8px;">
                                            <strong>Refund Amount:</strong> ₹@order.RefundAmount.Value.ToString("F2")
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(order.RefundTransactionId))
                                    {
                                        <div style="font-size: 0.95rem; font-weight: 600; margin-top: 8px; color: #666;">
                                            <strong>Refund TXN:</strong> @order.RefundTransactionId.Substring(0, Math.Min(15, order.RefundTransactionId.Length))...
                                        </div>
                                    }
                                    @if (order.RefundDate.HasValue)
                                    {
                                        <div style="font-size: 0.95rem; font-weight: 600; margin-top: 8px; color: #666;">
                                            <strong>Initiated:</strong> @order.RefundDate.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                        </div>
                                    }
                                    @if (order.RefundStatus == "Processing")
                                    {
                                        <div class="mt-3" style="font-size: 1rem; font-weight: 600; color: #856404;">
                                            <i class="bi bi-info-circle"></i> Refund will be credited to your original payment method within 5-7 business days.
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Request Refund Button (Flipkart-style) -->
                            @if (order.PaymentStatus == "Paid" && 
                                 (string.IsNullOrEmpty(order.RefundStatus) || order.RefundStatus == "Not Applicable") &&
                                 order.Status != "Cancelled" && order.Status != "Returned")
                            {
                                <div class="mt-3">
                                    <a asp-action="RefundForm" asp-route-id="@order.Id" class="action-btn btn btn-warning">
                                            <i class="bi bi-arrow-counterclockwise"></i> Request Refund
                                    </a>
                                </div>
                            }

                            <div class="mt-4">
                                <h5 style="font-weight: 700; margin-bottom: 15px;">Order Items:</h5>
                                @if (order.Items != null && order.Items.Any())
                                {
                                    @foreach (var item in order.Items)
                                    {
                                        <div class="d-flex justify-content-between align-items-center mb-3" style="padding: 15px; background: #f8f9fa; border-radius: 10px; border: 1px solid #e0e0e0;">
                                            <div class="d-flex align-items-center gap-3" style="flex: 1;">
                                                @if (item.Product != null && !string.IsNullOrEmpty(item.Product.ImageUrl))
                                                {
                                                    <img src="@item.Product.ImageUrl" alt="@item.Product.Name" 
                                                         style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" />
                                                }
                                                <div>
                                                    <div style="font-weight: 600; font-size: 1rem;">@(item.Product?.Name ?? "Unknown Product")</div>
                                                    <div class="text-muted" style="font-size: 0.9rem;">Quantity: @(item.Quantity)</div>
                                                    @if (!string.IsNullOrEmpty(item.ReturnStatus))
                                                    {
                                                        <span class="badge @(item.ReturnStatus == "Returned" ? "bg-success" : "bg-warning text-dark") mt-1">
                                                            @item.ReturnStatus
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <div style="font-weight: 700; font-size: 1.1rem;">₹@((item.UnitPrice * item.Quantity).ToString("N2"))</div>
                                        </div>
                                    </div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="text-end ms-4">
                            <div class="amount-display mb-4">₹@order.Total.ToString("N2")</div>
                            <div class="d-flex flex-column gap-2">
                                @if (order.Status != "Cancelled" && order.Status != "Delivered" && order.Status != "Returned" && order.Status != "Refunded" && order.Status != "Return Requested")
                                {
                                    <form asp-action="CancelOrder" asp-route-id="@order.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn btn btn-danger" 
                                                onclick="return confirm('Are you sure you want to cancel this order?');">
                                            <i class="bi bi-x-circle"></i> Cancel Order
                                        </button>
                                    </form>
                                }
                                @if ((order.Status == "Delivered" || order.Status == "Confirmed") && 
                                     order.Status != "Return Requested" && order.Status != "Returned")
                                {
                                    <form asp-action="ReturnOrder" asp-route-id="@order.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn btn btn-warning"
                                                onclick="return confirm('Are you sure you want to return this order?');">
                                            <i class="bi bi-arrow-counterclockwise"></i> Return Order
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    // Ensure modals are properly initialized and can be closed
    document.addEventListener('DOMContentLoaded', function() {
        // Clean up any existing backdrops first
        var existingBackdrops = document.querySelectorAll('.modal-backdrop');
        existingBackdrops.forEach(function(backdrop) {
            backdrop.remove();
        });
        document.body.classList.remove('modal-open');
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';

        // Handle modal backdrop cleanup when modal is hidden
        var modals = document.querySelectorAll('.modal');
        modals.forEach(function(modal) {
            modal.addEventListener('hidden.bs.modal', function() {
                // Remove any lingering backdrop
                var backdrops = document.querySelectorAll('.modal-backdrop');
                backdrops.forEach(function(backdrop) {
                    backdrop.remove();
                });
                // Remove modal-open class from body
                document.body.classList.remove('modal-open');
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';
            });

            // Ensure modal can be closed by clicking backdrop
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    var bsModal = bootstrap.Modal.getInstance(modal);
                    if (bsModal) {
                        bsModal.hide();
                    }
                }
            });
        });

        // Close modal on form submission (before submit)
        var returnForms = document.querySelectorAll('form[action*="ReturnItem"]');
        returnForms.forEach(function(form) {
            form.addEventListener('submit', function(e) {
                var modalElement = form.closest('.modal');
                if (modalElement) {
                    var bsModal = bootstrap.Modal.getInstance(modalElement);
                    if (bsModal) {
                        // Hide modal immediately on form submit
                        bsModal.hide();
                    }
                }
            });
        });
    });

    // Fallback: Close modal on escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            var openModal = document.querySelector('.modal.show');
            if (openModal) {
                var bsModal = bootstrap.Modal.getInstance(openModal);
                if (bsModal) {
                    bsModal.hide();
                } else {
                    // Fallback: manually remove if Bootstrap instance not found
                    openModal.classList.remove('show');
                    openModal.style.display = 'none';
                    var backdrops = document.querySelectorAll('.modal-backdrop');
                    backdrops.forEach(function(backdrop) {
                        backdrop.remove();
                    });
                    document.body.classList.remove('modal-open');
                    document.body.style.overflow = '';
                    document.body.style.paddingRight = '';
                }
            }
        }
    });

    // Clean up backdrop on page load (in case of previous errors)
    window.addEventListener('load', function() {
        var backdrops = document.querySelectorAll('.modal-backdrop');
        backdrops.forEach(function(backdrop) {
            backdrop.remove();
        });
        document.body.classList.remove('modal-open');
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
    });
</script>
}
