@model Order
@{
    ViewData["Title"] = "Shipping Details";
    decimal subtotal = ViewBag.Subtotal ?? 0m;
    decimal shipping = ViewBag.Shipping ?? 0m;
    decimal total = ViewBag.Total ?? 0m;
}

<div class="container py-4">
    <div class="row gy-4">
        <div class="col-lg-7">
            <div class="surface">
                <p class="section-subtitle mb-1">Step 1 of 2</p>
                <h1 class="h4 mb-3">Shipping details</h1>

                <form asp-action="Index" method="post" id="checkoutForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label"></label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Full name" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="AddressLine1" class="form-label"></label>
                            <input asp-for="AddressLine1" class="form-control" placeholder="Street address, house number" />
                            <span asp-validation-for="AddressLine1" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="AddressLine2" class="form-label">Address line 2 (optional)</label>
                            <input asp-for="AddressLine2" class="form-control" placeholder="Apartment, suite, etc." />
                            <span asp-validation-for="AddressLine2" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" placeholder="City" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Country" class="form-label"></label>
                            <input asp-for="Country" class="form-control" value="India" readonly />
                            <span asp-validation-for="Country" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PostalCode" class="form-label">PIN code</label>
                            <input asp-for="PostalCode" class="form-control" placeholder="123456" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a class="btn btn-secondary btn-sm" asp-controller="Cart" asp-action="Index">
                            Back to cart
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Continue to payment
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="cart-summary">
                <h2 class="h6 mb-3">Order summary</h2>
                <div class="d-flex justify-content-between mb-1">
                    <span class="product-meta">Subtotal</span>
                    <span class="product-meta">₹@subtotal.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="product-meta">Shipping</span>
                    @if (shipping > 0)
                    {
                        <span class="product-meta">₹@shipping.ToString("N2")</span>
                    }
                    else
                    {
                        <span class="text-success small">Free</span>
                    }
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between mb-0">
                    <span class="fw-semibold">Total</span>
                    <span class="fw-semibold">₹@total.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
