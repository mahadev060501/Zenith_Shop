@model Order
@{
    ViewData["Title"] = "Complete Payment";
    string razorpayKeyId = ViewBag.RazorpayKeyId as string ?? "";
    string razorpayOrderId = ViewBag.RazorpayOrderId as string ?? "";
    int razorpayAmount = ViewBag.RazorpayAmount ?? 0;
}

<style>
    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
    }
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 25px;
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
        padding: 40px;
    }
    .payment-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px;
        text-align: center;
        border-radius: 20px;
        margin-bottom: 30px;
    }
    .amount-display {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
        border-radius: 20px;
        padding: 35px;
        text-align: center;
        margin: 30px 0;
        box-shadow: 0 10px 30px rgba(17, 153, 142, 0.3);
    }
    .amount-value {
        font-size: 3.5rem;
        font-weight: 800;
        margin: 15px 0;
    }
    .amount-label {
        font-size: 1.3rem;
        font-weight: 700;
        opacity: 0.95;
    }
    .qr-code-container {
        background: white;
        padding: 30px;
        border-radius: 20px;
        display: inline-block;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        margin: 25px 0;
        border: 4px solid #667eea;
    }

    .payment-instructions {
        background: rgba(255, 243, 205, 0.95);
        backdrop-filter: blur(10px);
        border: 3px solid #ffc107;
        border-radius: 20px;
        padding: 25px;
        margin: 25px 0;
    }
    .payment-steps {
        list-style: none;
        padding: 0;
        counter-reset: step-counter;
    }
    .payment-steps li {
        padding: 15px 0;
        padding-left: 50px;
        position: relative;
        font-size: 1.1rem;
        font-weight: 600;
        color: #333;
    }
    .payment-steps li:before {
        content: counter(step-counter);
        counter-increment: step-counter;
        position: absolute;
        left: 0;
        top: 15px;
        background: #667eea;
        color: white;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
    }
    .confirm-payment-btn {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        border: none;
        padding: 20px 50px;
        font-size: 1.4rem;
        font-weight: 700;
        border-radius: 15px;
        color: white;
        transition: all 0.3s ease;
    }
    .confirm-payment-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(17, 153, 142, 0.5);
    }
    .payment-method-badge {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 25px;
        background: rgba(255, 255, 255, 0.2);
        color: white;
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 15px;
    }
    .card-form, .netbanking-form {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 30px;
        border-radius: 20px;
        margin: 25px 0;
    }
    .form-control, .form-select {
        font-size: 1.1rem;
        font-weight: 600;
        padding: 15px;
        border-radius: 12px;
        border: 2px solid #e0e0e0;
    }
    .form-label {
        font-size: 1.1rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 10px;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="glass-card">
                <div class="payment-header">
                    <h1 class="mb-3" style="font-size: 2.5rem; font-weight: 800;">
                        <i class="bi bi-qr-code-scan"></i> Complete Your Payment
                    </h1>
                    <p class="mb-2" style="font-size: 1.2rem; font-weight: 600; opacity: 0.9;">Order #@Model.Id - Payment Required</p>
                    <div class="alert alert-warning mb-3" style="background: rgba(255,193,7,0.3); border: 2px solid #ffc107; font-size: 1.1rem; font-weight: 700; padding: 15px;">
                        <i class="bi bi-info-circle"></i> Your order is pending. Complete payment to confirm your order.
                    </div>
                    <span class="payment-method-badge">
                        <i class="bi bi-credit-card"></i>
                        Razorpay Online Payment
                    </span>
                </div>

                <div class="card-body p-0">
                    <!-- Amount Display -->
                    <div class="amount-display">
                        <div class="amount-label">Pay Amount</div>
                        <div class="amount-value">₹@Model.Total.ToString("F2")</div>
                    </div>

                    <!-- Razorpay Online Payment -->
                    <div class="card-form">
                        <h3 class="mb-4" style="font-size: 1.8rem; font-weight: 800;">
                            <i class="bi bi-credit-card"></i> Pay securely with Razorpay
                        </h3>
                        <div class="alert alert-info mb-4" style="font-size: 1.1rem; font-weight: 600;">
                            <i class="bi bi-info-circle"></i> On the next screen, you can pay using debit/credit cards, net banking or wallets.
                        </div>
                        <div class="text-center mt-3">
                            <button type="button" id="razorpay-pay-btn" class="btn btn-primary btn-lg" style="font-size: 1.3rem; font-weight: 700; padding: 18px 50px;">
                                <i class="bi bi-lock-fill"></i> Pay ₹@Model.Total.ToString("F2") Securely
                            </button>
                        </div>
                        <div class="alert alert-success mt-4" style="font-size: 1.1rem; font-weight: 600;">
                            <i class="bi bi-shield-check"></i> Your payment is processed securely by Razorpay. We never store your card details.
                        </div>
                    </div>

                    <!-- Order Summary -->
                    <div class="mt-5">
                        <h4 class="mb-4" style="font-size: 1.8rem; font-weight: 800;">
                            <i class="bi bi-receipt"></i> Order Summary
                        </h4>
                        <div class="table-responsive">
                            <table class="table table-bordered" style="font-size: 1.1rem; font-weight: 600;">
                                <thead style="background: #667eea; color: white;">
                                    <tr>
                                        <th>Product</th>
                                        <th>Qty</th>
                                        <th>Price</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@item.Product?.Name</td>
                                            <td>@item.Quantity</td>
                                            <td>₹@item.UnitPrice.ToString("F2")</td>
                                            <td>₹@((item.Quantity * item.UnitPrice).ToString("F2"))</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot style="background: #f8f9fa; font-weight: 800;">
                                    <tr>
                                        <th colspan="3" class="text-end">Total:</th>
                                        <th>₹@Model.Total.ToString("F2")</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- No manual confirmation button; order is confirmed automatically after Razorpay payment. -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const razorpayKeyId = '@ViewBag.RazorpayKeyId';
            const razorpayOrderId = '@ViewBag.RazorpayOrderId';
            const amount = @ViewBag.RazorpayAmount;
            const customerName = '@Html.Raw(ViewBag.CustomerName?.Replace("'", "\\'"))';
            const customerEmail = '@Html.Raw(ViewBag.CustomerEmail?.Replace("'", "\\'"))';
            const customerContact = '@ViewBag.CustomerContact';
            const orderId = @Model.Id;

            const payButton = document.getElementById('razorpay-pay-btn');

            // Validate required configuration
            if (!payButton || !razorpayKeyId || !razorpayOrderId || !amount) {
                console.error('Razorpay configuration missing');
                if (payButton) {
                    payButton.disabled = true;
                    payButton.textContent = 'Payment Unavailable';
                }
                return;
            }

            payButton.addEventListener('click', function () {
                // Disable button to prevent double-click
                payButton.disabled = true;
                payButton.innerHTML = '<i class="bi bi-hourglass-split"></i> Processing...';

                // Convert amount from paise to rupees for display
                const amountInRupees = (amount / 100).toFixed(2);

                const options = {
                    key: razorpayKeyId,
                    amount: amount,
                    currency: "INR",
                    name: "ZenithShop",
                    description: "Order #" + orderId + " - ₹" + amountInRupees,
                    order_id: razorpayOrderId,
                    image: "https://cdn.razorpay.com/logo.png",
                    handler: function (response) {
                        // Submit payment details to server for verification
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = '@Url.Action("VerifyPayment", "Checkout")';

                        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        if (csrfToken) {
                            const csrfInput = document.createElement('input');
                            csrfInput.type = 'hidden';
                            csrfInput.name = '__RequestVerificationToken';
                            csrfInput.value = csrfToken;
                            form.appendChild(csrfInput);
                        }

                        const paymentIdInput = document.createElement('input');
                        paymentIdInput.type = 'hidden';
                        paymentIdInput.name = 'razorpay_payment_id';
                        paymentIdInput.value = response.razorpay_payment_id;
                        form.appendChild(paymentIdInput);

                        const razorpayOrderIdInput = document.createElement('input');
                        razorpayOrderIdInput.type = 'hidden';
                        razorpayOrderIdInput.name = 'razorpay_order_id';
                        razorpayOrderIdInput.value = response.razorpay_order_id;
                        form.appendChild(razorpayOrderIdInput);

                        const signatureInput = document.createElement('input');
                        signatureInput.type = 'hidden';
                        signatureInput.name = 'razorpay_signature';
                        signatureInput.value = response.razorpay_signature;
                        form.appendChild(signatureInput);

                        document.body.appendChild(form);
                        form.submit();
                    },
                    prefill: {
                        name: customerName,
                        email: customerEmail,
                        contact: customerContact
                    },
                    theme: {
                        color: "#2874f0"
                    },
                    modal: {
                        ondismiss: function () {
                            // Re-enable button when modal is dismissed
                            payButton.disabled = false;
                            payButton.innerHTML = '<i class="bi bi-lock-fill"></i> Pay ₹@Model.Total.ToString("F2") Securely';
                        }
                    }
                };

                try {
                    const rzp = new Razorpay(options);

                    // Handle payment failure
                    rzp.on('payment.failed', function (response) {
                        console.error('Payment failed:', response.error);
                        alert('Payment failed: ' + response.error.description);
                        payButton.disabled = false;
                        payButton.innerHTML = '<i class="bi bi-lock-fill"></i> Pay ₹@Model.Total.ToString("F2") Securely';
                    });

                    rzp.open();
                } catch (error) {
                    console.error('Error initializing Razorpay:', error);
                    alert('Unable to initialize payment. Please refresh and try again.');
                    payButton.disabled = false;
                    payButton.innerHTML = '<i class="bi bi-lock-fill"></i> Pay ₹@Model.Total.ToString("F2") Securely';
                }
            });
        });
    </script>
}




