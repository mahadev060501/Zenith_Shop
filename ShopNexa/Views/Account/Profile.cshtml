@model ApplicationUser
@{
    ViewData["Title"] = "My Profile";
}

<style>
    body {
        background: #f5f7fa;
    }
    .profile-container {
        max-width: 900px;
        margin: 40px auto;
    }
    .profile-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        padding: 30px;
        margin-bottom: 20px;
    }
    .profile-header {
        text-align: center;
        padding-bottom: 30px;
        border-bottom: 2px solid #e0e0e0;
        margin-bottom: 30px;
    }
    .profile-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 3rem;
        font-weight: 900;
        margin: 0 auto 20px;
    }
    .form-label {
        font-weight: 700;
        color: #333;
        margin-bottom: 8px;
    }
    .form-control {
        padding: 12px;
        border-radius: 8px;
        border: 2px solid #e0e0e0;
        font-weight: 600;
    }
    .btn-save {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 12px 40px;
        font-weight: 700;
        border-radius: 8px;
    }
</style>

<div class="container profile-container">
    <div class="profile-card">
        <div class="profile-header">
            <div class="profile-avatar">
                @(Model.FullName?.Substring(0, 1).ToUpper() ?? Model.UserName?.Substring(0, 1).ToUpper() ?? "U")
            </div>
            <h2 style="font-weight: 900; color: #1a1a1a;">@(Model.FullName ?? Model.UserName)</h2>
            <p class="text-muted" style="font-weight: 700;">@Model.Email</p>
        </div>

        <form asp-action="UpdateProfile" method="post">
            @Html.AntiForgeryToken()
            
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="fullName" class="form-control" value="@Model.FullName" placeholder="Enter your full name" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" value="@Model.Email" disabled />
                    <small class="text-muted">Email cannot be changed</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Phone Number</label>
                    <input type="tel" name="phoneNumber" class="form-control" value="@Model.PhoneNumber" placeholder="Enter phone number" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Username</label>
                    <input type="text" class="form-control" value="@Model.UserName" disabled />
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-save">
                    <i class="bi bi-check-circle"></i> Save Changes
                </button>
                <a asp-action="Settings" class="btn btn-outline-secondary ms-2">
                    <i class="bi bi-gear"></i> Account Settings
                </a>
            </div>
        </form>
    </div>
</div>

