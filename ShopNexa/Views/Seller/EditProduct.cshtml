@model Product
@{
    ViewData["Title"] = "Edit Product";
}

<style>
    .product-form-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        padding: 40px 0;
    }
    .form-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.1);
        overflow: hidden;
    }
    .form-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px;
        text-align: center;
    }
    .form-body {
        padding: 40px;
    }
    .form-section {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        border-left: 4px solid #667eea;
    }
    .form-section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #667eea;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .form-control-modern {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 12px 16px;
        transition: all 0.3s ease;
        font-size: 1rem;
    }
    .form-control-modern:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
        transform: translateY(-2px);
    }
    .form-label-modern {
        font-weight: 600;
        color: #495057;
        margin-bottom: 8px;
        font-size: 0.95rem;
    }
    .image-preview {
        width: 100%;
        max-width: 300px;
        height: 200px;
        object-fit: cover;
        border-radius: 12px;
        border: 2px solid #dee2e6;
        margin-top: 10px;
    }
    .help-text {
        font-size: 0.85rem;
        color: #6c757d;
        margin-top: 5px;
    }
    .btn-submit {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        padding: 14px 40px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 10px;
        transition: all 0.3s ease;
    }
    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
    }
</style>

<div class="product-form-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="form-card">
                    <div class="form-header">
                        <h2 class="mb-2"><i class="bi bi-pencil-square"></i> Edit Product</h2>
                        <p class="mb-0 opacity-75">Update your product information</p>
                    </div>
                    
                    <div class="form-body">
                        <form asp-action="EditProduct" method="post" id="productForm">
                            @Html.AntiForgeryToken()
                            <input asp-for="Id" type="hidden" />
                            
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                            <!-- Basic Information -->
                            <div class="form-section">
                                <div class="form-section-title">
                                    <i class="bi bi-info-circle"></i> Basic Information
                                </div>
                                
                                <div class="mb-4">
                                    <label asp-for="Name" class="form-label-modern">
                                        Product Name <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Name" class="form-control form-control-modern" 
                                           placeholder="Enter product name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Description" class="form-label-modern">Product Description</label>
                                    <textarea asp-for="Description" class="form-control form-control-modern" 
                                              rows="5" placeholder="Describe your product..."></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Pricing & Inventory -->
                            <div class="form-section">
                                <div class="form-section-title">
                                    <i class="bi bi-currency-rupee"></i> Pricing & Inventory
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-4">
                                        <label asp-for="Price" class="form-label-modern">
                                            Price (₹) <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light">₹</span>
                                            <input asp-for="Price" class="form-control form-control-modern" 
                                                   type="number" step="0.01" min="0" />
                                        </div>
                                        <span asp-validation-for="Price" class="text-danger"></span>
                                    </div>
                                    
                                    <div class="col-md-6 mb-4">
                                        <label asp-for="Stock" class="form-label-modern">
                                            Stock Quantity <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="Stock" class="form-control form-control-modern" 
                                               type="number" min="0" />
                                        <span asp-validation-for="Stock" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Category & Image -->
                            <div class="form-section">
                                <div class="form-section-title">
                                    <i class="bi bi-tags"></i> Category & Image
                                </div>
                                
                                <div class="mb-4">
                                    <label asp-for="CategoryId" class="form-label-modern">
                                        Category <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="CategoryId" asp-items="@(ViewBag.Categories as SelectList)" 
                                            class="form-select form-control-modern">
                                        <option value="">-- Select a Category --</option>
                                    </select>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="ImageUrl" class="form-label-modern">Product Image URL</label>
                                    <input asp-for="ImageUrl" class="form-control form-control-modern" 
                                           type="url" placeholder="https://example.com/product-image.jpg" 
                                           id="imageUrlInput" />
                                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <img src="@Model.ImageUrl" id="imagePreview" class="image-preview" alt="Product preview" />
                                    }
                                    else
                                    {
                                        <img id="imagePreview" class="image-preview" style="display: none;" alt="Product preview" />
                                    }
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex gap-3 justify-content-end mt-4">
                                <a asp-action="Products" class="btn btn-outline-secondary btn-lg px-4">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-submit text-white">
                                    <i class="bi bi-check-circle-fill"></i> Update Product
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('imageUrlInput').addEventListener('input', function(e) {
            const preview = document.getElementById('imagePreview');
            const url = e.target.value;
            
            if (url && isValidUrl(url)) {
                preview.src = url;
                preview.style.display = 'block';
            } else if (!url && '@Model.ImageUrl' === '') {
                preview.style.display = 'none';
            }
        });

        function isValidUrl(string) {
            try {
                new URL(string);
                return true;
            } catch (_) {
                return false;
            }
        }
    </script>
}
