@model IEnumerable<Product>
@{
    ViewData["Title"] = "Products";
    Layout = "_SellerLayout";
}

<div class="dashboard-header">
    <h1>My Products</h1>
    <p>Manage your product catalog</p>
</div>

<div class="section-card">
    <div class="section-header">
        <h2 class="section-title">All Products</h2>
        <a asp-action="CreateProduct" class="btn-add">
            <i class="bi bi-plus-lg"></i> Add Product
        </a>
    </div>

    @if (Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" />
                                }
                                else
                                {
                                    <div style="width: 50px; height: 50px; background: #f0f0f0; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                }
                                <div>
                                    <strong>@product.Name</strong>
                                    @if (!string.IsNullOrEmpty(product.Description))
                                    {
                                        <div class="text-muted small">@product.Description.Substring(0, Math.Min(50, product.Description.Length))...</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>@product.Category?.Name</td>
                        <td>
                            @if (product.OriginalPrice.HasValue && product.OriginalPrice > product.Price)
                            {
                                <div>
                                    <strong>₹@product.Price.ToString("N0")</strong>
                                    <span class="text-muted text-decoration-line-through">₹@product.OriginalPrice.Value.ToString("N0")</span>
                                </div>
                            }
                            else
                            {
                                <strong>₹@product.Price.ToString("N0")</strong>
                            }
                        </td>
                        <td>
                            @if (product.Stock > 10)
                            {
                                <span class="badge bg-success">@product.Stock in stock</span>
                            }
                            else if (product.Stock > 0)
                            {
                                <span class="badge bg-warning text-dark">@product.Stock left</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of stock</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-box" style="font-size: 3rem; color: #ddd;"></i>
            <p class="mt-3 text-muted">No products yet. Add your first product to start selling!</p>
            <a asp-action="CreateProduct" class="btn-add mt-3">
                <i class="bi bi-plus-lg"></i> Add Product
            </a>
        </div>
    }
</div>


