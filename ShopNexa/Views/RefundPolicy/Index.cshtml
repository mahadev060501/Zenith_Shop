@{
    ViewData["Title"] = "Refund Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-custom">
                <div class="card-body p-5">
                    <h1 class="mb-4">Refund Policy</h1>
                    <p class="text-muted mb-4">Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>

                    <div class="mb-5">
                        <h3 class="mb-3">1. Refund Eligibility</h3>
                        <p>We offer refunds for products that meet the following criteria:</p>
                        <ul>
                            <li>Product is unused, unopened, and in its original packaging</li>
                            <li>Refund request is made within 7 days of delivery</li>
                            <li>Product is defective, damaged, or incorrect item received</li>
                            <li>Product does not match the description on our website</li>
                        </ul>
                    </div>

                    <div class="mb-5">
                        <h3 class="mb-3">2. Refund Process</h3>
                        <p>To request a refund:</p>
                        <ol>
                            <li>Go to "My Orders" section in your account</li>
                            <li>Select the order you want to return/refund</li>
                            <li>Click on "Return" or "Cancel" button</li>
                            <li>Select the reason for return/refund</li>
                            <li>Submit your request</li>
                        </ol>
                        <p class="mt-3">Once your request is approved, we will process the refund within 5-7 business days.</p>
                    </div>

                    <div class="mb-5">
                        <h3 class="mb-3">3. Refund Methods</h3>
                        <p>Refunds will be processed to the original payment method used for the purchase:</p>
                        <ul>
                            <li><strong>Razorpay Online Payment:</strong> Refund will be credited back to your original Razorpay payment source (card, wallet or net banking) within 5-7 business days</li>
                            <li><strong>Cash on Delivery:</strong> Refund will be processed via bank transfer or wallet credit within 5-7 business days</li>
                        </ul>
                    </div>

                    <div class="mb-5">
                        <h3 class="mb-3">4. Refund Amount</h3>
                        <p>The refund amount will include:</p>
                        <ul>
                            <li>Full product price</li>
                            <li>Shipping charges (if applicable)</li>
                            <li>Taxes (if applicable)</li>
                        </ul>
                        <p class="mt-3"><strong>Note:</strong> In case of partial returns, only the returned items' amount will be refunded.</p>
                    </div>

                    <div class="mb-5">
                        <h3 class="mb-3">5. Non-Refundable Items</h3>
                        <p>The following items are not eligible for refund:</p>
                        <ul>
                            <li>Items returned after 7 days of delivery</li>
                            <li>Items without original packaging or tags</li>
                            <li>Items damaged due to misuse or negligence</li>
                            <li>Digital products or downloadable content</li>
                            <li>Gift cards or vouchers</li>
                        </ul>
                    </div>

                    <div class="mb-5">
                        <h3 class="mb-3">6. Return Shipping</h3>
                        <p>For eligible returns:</p>
                        <ul>
                            <li>We provide free return pickup for orders above ₹500</li>
                            <li>For orders below ₹500, return shipping charges may apply</li>
                            <li>Return shipping charges will be deducted from the refund amount if applicable</li>
                        </ul>
                    </div>

                    <div class="mb-5">
                        <h3 class="mb-3">7. Cancellation Policy</h3>
                        <p>You can cancel your order:</p>
                        <ul>
                            <li><strong>Before Shipping:</strong> Full refund will be processed immediately</li>
                            <li><strong>After Shipping:</strong> You can return the product after delivery for a full refund</li>
                            <li><strong>Cash on Delivery:</strong> You can refuse delivery at the time of delivery</li>
                        </ul>
                    </div>

                    <div class="mb-5">
                        <h3 class="mb-3">8. Contact Us</h3>
                        <p>If you have any questions about our refund policy, please contact us:</p>
                        <ul>
                            <li><strong>Email:</strong> mahadev010506@gmail.com</li>
                            <li><strong>Phone:</strong> +91 7822002380</li>
                            <li><strong>Business Hours:</strong> Monday - Saturday, 9:00 AM - 6:00 PM IST</li>
                        </ul>
                    </div>

                    <div class="alert alert-info">
                        <strong>Important:</strong> Please keep your order number and payment reference handy when contacting us for faster resolution.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



